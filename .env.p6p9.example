# HMRC P6/P9 Tax Code Monitoring Configuration
# ==============================================

# Enable/disable P6/P9 monitoring
HMRC_P6P9_ENABLED=true

# Check method: 'email' or 'api'
HMRC_P6P9_METHOD=email

# Email Configuration (for parsing HMRC emails)
# ---------------------------------------------
HMRC_P6P9_EMAIL_ENABLED=true
HMRC_P6P9_EMAIL_HOST=imap.gmail.com
HMRC_P6P9_EMAIL_USERNAME=your-email@example.com
HMRC_P6P9_EMAIL_PASSWORD=your-app-password
HMRC_P6P9_EMAIL_FOLDER=INBOX
HMRC_P6P9_EMAIL_SSL=true

# Email fetch method: 'unread', 'today', or 'since'
HMRC_P6P9_EMAIL_FETCH=unread

# Date to fetch since (only if FETCH=since)
# Format: 'd-M-Y' (e.g., '01-Jan-2025')
HMRC_P6P9_EMAIL_SINCE=

# API Configuration (for checking via HMRC API)
# ---------------------------------------------
HMRC_P6P9_API_ENABLED=false

# Comma-separated list of NINOs to check
HMRC_P6P9_EMPLOYEES=AB123456C,CD789012E

# Use database to fetch employees
HMRC_P6P9_USE_DB=false
HMRC_P6P9_MODEL=App\Models\Employee

# Use CSV file for employee list
HMRC_P6P9_CSV=

# Scheduling Configuration
# ------------------------
# Cron expression (default: daily at 6 AM)
HMRC_P6P9_SCHEDULE="0 6 * * *"

# Laravel schedule frequency: 'daily', 'twiceDaily', 'hourly', 'everyFourHours'
HMRC_P6P9_FREQUENCY=daily

# Time for daily/twiceDaily (24-hour format)
HMRC_P6P9_TIME=06:00

# Notification Configuration
# --------------------------
HMRC_P6P9_NOTIFY=true

# Comma-separated email addresses
HMRC_P6P9_NOTIFY_TO=payroll@example.com,admin@example.com

# Send notification even if no changes
HMRC_P6P9_NOTIFY_ALWAYS=false

# Send notification on job failure
HMRC_P6P9_NOTIFY_FAILURE=true

# Export Configuration
# --------------------
HMRC_P6P9_EXPORT=true
HMRC_P6P9_EXPORT_PATH=storage/app/hmrc/p6p9

# Keep exports for X days
HMRC_P6P9_EXPORT_RETENTION=90

# Cache Configuration
# -------------------
HMRC_P6P9_CACHE_DRIVER=
HMRC_P6P9_CACHE_TTL=604800

# Logging Configuration
# ---------------------
HMRC_P6P9_LOG_CHANNEL=daily
HMRC_P6P9_LOG_LEVEL=info
